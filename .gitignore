# Swift Package Manager
.build/
.swiftpm/
Package.resolved.bak
*.xcodeproj/
*.xcworkspace/
DerivedData/

# Xcode / Instruments
*.dSYM/
*.dSYM.zip
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Codegen output is COMMITTED so consumers don't need pnpm+@qvac/sdk to build.
# YK-194 CI re-runs codegen and fails on any non-empty git diff — the lockfile
# in scripts/codegen/pnpm-lock.yaml + the pin in scripts/codegen/package.json
# guarantee deterministic regeneration.

# Node (codegen toolchain under scripts/codegen/, YK-178)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Bare worker bundle artifacts (YK-207)
worker.bundle/
worker.bundle.js
*.mobile.bundle.js

# Local env / scratch
.env
.env.local
.env.*.local
.tmp/
tmp/
*.log

# macOS
.DS_Store
.AppleDouble
.LSOverride

# DocC build output (YK-215, YK-217)
*.doccarchive
.docc-build/

# Coverage
*.profraw
*.profdata
coverage/
.coverage/

# YK-206 — BareKit.xcframework is downloaded locally via
# scripts/download-barekit.sh, not committed. ~20MB.
Vendor/BareKit.xcframework/
